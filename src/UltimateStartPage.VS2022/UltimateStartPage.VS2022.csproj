<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{B1B2B3B4-C1C2-D1D2-E1E2-F1F2F3F4F5F6}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>UltimateStartPage.VS2022</RootNamespace>
    <AssemblyName>UltimateStartPage.VS2022</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <!--
      RegisterOutputPackage and RegisterWithCodebase deploy the VSIX to the VS experimental
      instance. This is only valid inside Visual Studio — dotnet build rejects VSIX deployment
      with an error, so restrict these flags to VS builds only.
    -->
    <RegisterOutputPackage Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</RegisterOutputPackage>
    <RegisterWithCodebase Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</RegisterWithCodebase>
  </PropertyGroup>

  <!--
    The WPF markup compiler (MarkupCompilePass1) creates a temporary project that outputs the
    compiled assembly to $(IntermediateOutputPath), causing the main CoreCompile to be skipped
    (it considers outputs up-to-date). The VSSDK CreatePkgDef task normally looks at
    $(TargetPath) = bin\Debug\, which doesn't exist. Override to use the intermediate path.
  -->
  <PropertyGroup>
    <CreatePkgDefAssemblyToProcess>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(AssemblyName).dll</CreatePkgDefAssemblyToProcess>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.VisualStudio.SDK brings in all VS SDK assemblies as NuGet references.
      ExcludeAssets=runtime prevents them being copied to output (they live in the VS install).
      Microsoft.VSSDK.BuildTools provides the VSIX packaging MSBuild targets.
    -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.31902.203" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.10.2179" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF framework assemblies required for XAML compilation and the UserControl -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System" />
    <Reference Include="System.Runtime" />
    <!-- OleMenuCommandService inherits from MenuCommandService in System.Design;
         System.Design itself depends on System.Drawing. -->
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Explicit VS SDK assembly references. These are required because the WPF markup compiler
      creates a temporary project (_wpftmp.csproj) that does not inherit PackageReferences,
      so the VS SDK assemblies must be listed as explicit <Reference> items for XAML compilation
      to succeed. Private=False prevents them from being copied to output — they live in the
      VS installation and are excluded from the VSIX package.
    -->
    <Reference Include="Microsoft.VisualStudio.Shell.15.0">
      <HintPath>$(NuGetPackageRoot)microsoft.visualstudio.shell.15.0\17.0.31902.203\lib\net472\Microsoft.VisualStudio.Shell.15.0.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Framework">
      <HintPath>$(NuGetPackageRoot)microsoft.visualstudio.shell.framework\17.0.31902.203\lib\net472\Microsoft.VisualStudio.Shell.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Interop">
      <HintPath>$(NuGetPackageRoot)microsoft.visualstudio.shell.interop\17.0.31902.203\lib\net472\Microsoft.VisualStudio.Shell.Interop.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="EnvDTE">
      <HintPath>$(NuGetPackageRoot)envdte\17.0.31902.203\lib\net472\envdte.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.OLE.Interop">
      <HintPath>$(NuGetPackageRoot)microsoft.visualstudio.ole.interop\17.0.31902.203\lib\net472\Microsoft.VisualStudio.OLE.Interop.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Interop">
      <HintPath>$(NuGetPackageRoot)microsoft.visualstudio.interop\17.0.31902.203\lib\net472\Microsoft.VisualStudio.Interop.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Threading">
      <!--
        Use the NuGet-resolved Threading assembly so the reference works with both
        dotnet build and VS MSBuild. The version matches the transitive dependency
        resolved from Microsoft.VisualStudio.SDK 17.0.31902.203.
      -->
      <HintPath>$(NuGetPackageRoot)microsoft.visualstudio.threading\17.0.64\lib\net472\Microsoft.VisualStudio.Threading.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Utilities">
      <!--
        Use the NuGet-resolved Utilities assembly so the reference works with both
        dotnet build and VS MSBuild.
      -->
      <HintPath>$(NuGetPackageRoot)microsoft.visualstudio.utilities\17.0.31902.203\lib\net472\Microsoft.VisualStudio.Utilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Converters\InverseBooleanToVisibilityConverter.cs" />
    <Compile Include="Guids.cs" />
    <Compile Include="ShowStartPageCommand.cs" />
    <Compile Include="UltimateStartPagePackage.cs" />
    <Compile Include="ToolWindows\StartPageToolWindow.cs" />
    <Compile Include="ToolWindows\StartPageToolWindowControl.xaml.cs">
      <DependentUpon>StartPageToolWindowControl.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Include="ToolWindows\StartPageToolWindowControl.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UltimateStartPage.Core\UltimateStartPage.Core.csproj">
      <Project>{A1A2A3A4-B1B2-C1C2-D1D2-E1E2E3E4E5E6}</Project>
      <Name>UltimateStartPage.Core</Name>
      <!--
        IncludeAssemblyInVSIXContainer=true ensures the Core DLL is bundled inside the .vsix
        package. Without this the Core assembly is not deployed and the extension fails to load.
        The VS2022 project's own assembly is excluded (IncludeAssemblyInVSIXContainer=false in the
        main PropertyGroup) because it is handled by pkgdef registration — only referenced
        assemblies that are NOT part of the VS install need explicit inclusion.
      -->
      <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="UltimateStartPage.VS2022Commands.vsct">
      <!--
        ResourceName must match the string in [ProvideMenuResource("Menus.ctmenu", 1)].
        VSSDK compiles the .vsct into a binary resource embedded in the assembly.
      -->
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!--
    When building with dotnet build (MSBuildRuntimeType == Core), disable VSIX deployment.
    VSIX deployment requires VS-hosted MSBuild tools that are unavailable in CoreCLR mode.
    CreateVsixContainer is still allowed so the .vsix package is produced for CI artifact
    publishing — only the local VS experimental-instance deployment is suppressed.
  -->
  <PropertyGroup Condition="'$(MSBuildRuntimeType)' == 'Core'">
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>

  <!--
    WPF XAML compilation (generates InitializeComponent for <Page> items).
    When built with VS MSBuild, Microsoft.WinFx.targets lives in $(MSBuildBinPath).
    When built with dotnet build, MSBuildBinPath points to the .NET SDK which does not
    include WinFx targets, so fall back to the WindowsDesktop SDK version, which
    automatically selects the CoreCLR-compatible PresentationBuildTasks.dll.
  -->
  <Import Project="$(MSBuildBinPath)\Microsoft.WinFx.targets"
          Condition="Exists('$(MSBuildBinPath)\Microsoft.WinFx.targets')" />
  <Import Project="$(MSBuildSDKsPath)\Microsoft.NET.Sdk.WindowsDesktop\targets\Microsoft.WinFX.targets"
          Condition="!Exists('$(MSBuildBinPath)\Microsoft.WinFx.targets') And Exists('$(MSBuildSDKsPath)\Microsoft.NET.Sdk.WindowsDesktop\targets\Microsoft.WinFX.targets')" />

  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets"
          Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
