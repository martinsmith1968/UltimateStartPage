<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-agnostic core: models, persistence, the VS recent-items reader and the view models.
    Targets netstandard2.0 so it loads inside Visual Studio (.NET Framework 4.8) and can be
    unit tested on any platform without a Visual Studio install.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>UltimateStartPage.Core</RootNamespace>
    <AssemblyName>UltimateStartPage.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UltimateStartPage.Core.Tests" />
  </ItemGroup>

</Project>
