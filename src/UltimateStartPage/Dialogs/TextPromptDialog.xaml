<platformUI:DialogWindow x:Class="UltimateStartPage.Dialogs.TextPromptDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                        xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
                        toolkit:Themes.UseVsTheme="True"
                        Width="380" SizeToContent="Height" ResizeMode="NoResize"
                        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                        FocusManager.FocusedElement="{Binding ElementName=InputBox}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" Padding="4,3" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</platformUI:DialogWindow>
