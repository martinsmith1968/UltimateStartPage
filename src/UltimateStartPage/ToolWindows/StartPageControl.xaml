<UserControl x:Class="UltimateStartPage.ToolWindows.StartPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:local="clr-namespace:UltimateStartPage.ToolWindows"
             xmlns:vm="clr-namespace:UltimateStartPage.Core.ViewModels;assembly=UltimateStartPage.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StartPageViewModel}"
             d:DesignHeight="700" d:DesignWidth="1200"
             toolkit:Themes.UseVsTheme="True"
             Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
        <local:AnyTrueToVisibilityConverter x:Key="AnyTrueToVisibility" />
        <local:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
        <local:LinkKindToMonikerConverter x:Key="KindToMoniker" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="CardBackground" Color="#0F808080" />

        <!-- Small square glyph button used for toolbar-style actions. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat text button for header actions. -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A whole clickable row: icon, title and a dimmed second line. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="6,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ControlLinkTextBrushKey}}" />
        </Style>

        <Style x:Key="RowSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6,4" />
        </Style>

        <!-- One link inside a section card. -->
        <DataTemplate x:Key="LinkTemplate" DataType="{x:Type vm:LinkViewModel}">
            <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Open" Command="{Binding OpenCommand}" FontWeight="SemiBold" />
                        <MenuItem Header="_Edit…" Command="{Binding EditCommand}" />
                        <MenuItem Header="Open containing _folder" Command="{Binding OpenContainingFolderCommand}" />
                        <Separator />
                        <MenuItem Header="Move _up" Command="{Binding MoveUpCommand}" />
                        <MenuItem Header="Move _down" Command="{Binding MoveDownCommand}" />
                        <Separator />
                        <MenuItem Header="_Remove" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </Grid.ContextMenu>

                <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <imaging:CrispImage Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                            Moniker="{Binding Kind, Converter={StaticResource KindToMoniker}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Target}" Style="{StaticResource RowSubtitle}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move up" Command="{Binding MoveUpCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move down" Command="{Binding MoveDownCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit…" Command="{Binding EditCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove" Command="{Binding RemoveCommand}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A user-defined section card. Files and folders can be dropped onto it from Explorer. -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:SectionViewModel}">
            <Border Width="380" Margin="0,0,16,16" Padding="10,8" CornerRadius="6" BorderThickness="1"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                    AllowDrop="True" DragEnter="OnSectionDragOver" DragOver="OnSectionDragOver" Drop="OnSectionDrop">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;"
                                ToolTip="Add a link to this section" Command="{Binding AddLinkCommand}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Move section earlier" Command="{Binding MoveUpCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Move section later" Command="{Binding MoveDownCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" ToolTip="Rename section…" Command="{Binding RenameCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete section" Command="{Binding DeleteCommand}" />
                        </StackPanel>

                        <Button DockPanel.Dock="Left" Command="{Binding ToggleCollapsedCommand}" ToolTip="Collapse or expand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="&#xE70D;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter Property="Content" Value="&#xE76C;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Grid VerticalAlignment="Center" Margin="4,0">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="2,1"
                                     Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Style="{StaticResource Hint}" Text="Empty. Click + or drag solutions and folders here from Explorer."
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkTemplate}" Focusable="False" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- One entry from Visual Studio's recent list. -->
        <DataTemplate x:Key="RecentTemplate" DataType="{x:Type vm:RecentItemViewModel}">
            <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Open" Command="{Binding OpenCommand}" FontWeight="SemiBold" />
                        <MenuItem Header="_Pin to section…" Command="{Binding PinCommand}" />
                    </ContextMenu>
                </Grid.ContextMenu>

                <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" ToolTip="{Binding FullPath}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <imaging:CrispImage Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                            Moniker="{Binding Kind, Converter={StaticResource KindToMoniker}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding FullPath}" Style="{StaticResource RowSubtitle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding LastAccessedText}" Style="{StaticResource RowSubtitle}"
                                   Margin="8,1,0,0" VerticalAlignment="Top" />
                    </Grid>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE718;" VerticalAlignment="Center"
                        ToolTip="Pin to one of your sections" Command="{Binding PinCommand}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, search and layout actions -->
        <DockPanel Margin="0,0,8,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="280">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4,26,4" VerticalContentAlignment="Center"
                             ToolTip="Filter sections, links and recent items (Esc clears)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Search" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Width="22" Height="22"
                            Margin="0,0,2,0" ToolTip="Clear search" Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}" />
                </Grid>

                <Button Style="{StaticResource TextButton}" Margin="12,0,0,0" Command="{Binding AddSectionCommand}" ToolTip="Add a new section">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Add section" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TextButton}" Content="Edit layout" Command="{Binding ToggleEditModeCommand}"
                        ToolTip="Rename, reorder and delete sections and links"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <Button Style="{StaticResource TextButton}" Content="Done" FontWeight="SemiBold" Command="{Binding ToggleEditModeCommand}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE712;" Margin="6,0,0,0" ToolTip="More" Click="OnMoreClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Import layout…" Command="{Binding ImportCommand}" />
                            <MenuItem Header="_Export layout…" Command="{Binding ExportCommand}" />
                            <MenuItem Header="Edit layout _JSON file" Command="{Binding OpenLayoutFileCommand}" />
                            <MenuItem Header="_Reload" Command="{Binding RefreshCommand}" />
                            <Separator />
                            <MenuItem Header="_Options…" Command="{Binding OpenOptionsCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <TextBlock Text="Start Page" FontSize="28" FontWeight="Light" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: get started + Visual Studio's recent list -->
            <ScrollViewer Width="340" Margin="0,0,32,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ScrollViewer.Visibility>
                    <MultiBinding Converter="{StaticResource AnyTrueToVisibility}">
                        <Binding Path="ShowGetStartedActions" />
                        <Binding Path="ShowRecentItems" />
                    </MultiBinding>
                </ScrollViewer.Visibility>
                <StackPanel Margin="0,0,0,24">
                    <StackPanel Margin="0,0,0,20" Visibility="{Binding ShowGetStartedActions, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Get started" Style="{StaticResource SectionHeading}" />
                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenProjectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Open a project or solution" Style="{StaticResource RowTitle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Open a local folder" Style="{StaticResource RowTitle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Command="{Binding CloneRepositoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Clone a repository" Style="{StaticResource RowTitle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Command="{Binding NewProjectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Create a new project" Style="{StaticResource RowTitle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowRecentItems, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Recent" Style="{StaticResource SectionHeading}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Solutions and folders you open will appear here."
                                   Visibility="{Binding RecentItems.Count, Converter={StaticResource ZeroToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding RecentItems}" ItemTemplate="{StaticResource RecentTemplate}" Focusable="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: the user's own sections -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource Hint}" FontSize="13"
                               Text="You have no sections yet. Click 'Add section' to create one, then add solutions, folders and links to it."
                               Visibility="{Binding HasNoSections, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
